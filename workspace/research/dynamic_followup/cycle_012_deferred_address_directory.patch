+    def test_prompt_supplies_current_addresses_for_cross_group_dispatch(self):
+        # Discover a destination from the real worker prompt, not test-only IDs.
+        prompt = self.bridge.prompt("1", "original")
+        context, _ = json.JSONDecoder().raw_decode(
+            prompt.split("[TASK GROUP — ADVISORY]\n", 1)[1])
+        directory = context["group_directory"]
+        target = next(group for group in directory if group["id"] != context["group"])
+        self.assertEqual(set(target), {"id", "members", "leader"})
+        self.bridge.dispatch(self.agents["1"],
+            f'<EDGE id="{context["group"]}" target="{target["id"]}">'
+            f'<AGENT_{target["leader"]}>Need support</AGENT_{target["leader"]}></EDGE>', {})
+        self.assertIn("Need support", self.agents[target["leader"]].chat_history["GLOBAL"][-1][1])
+        # The directory follows retirement/reassignment instead of retaining old IDs.
+        revised = {"based_on_version": 1, "evidence_id": 1,
+                   "edges": [{"id": "merged", "goal": "Search together",
+                              "members": ["1", "2", "3"], "leader": "2"}],
+                   "active": {aid: "merged" for aid in self.agents}}
+        self.bridge.graph.apply(revised)
+        updated, _ = json.JSONDecoder().raw_decode(
+            self.bridge.prompt("1", "original").split("[TASK GROUP — ADVISORY]\n", 1)[1])
+        self.assertEqual(updated["group_directory"], [
+            {"id": "merged", "members": ["1", "2", "3"], "leader": "2"}])
+
